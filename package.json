{
  "name": "p2p-ai",
  "version": "1.0.0",
  "description": "把 Claude Code 变成一个 P2P 对端：监听房间、自动同意、持续对话、双向传输文件",
  "main": "src/daemon.js",
  "bin": {
    "p2p-listen": "bin/p2p-listen.js",
    "p2p-connect": "bin/p2p-connect.js",
    "p2p-ctl": "bin/p2p-ctl.js"
  },
  "scripts": {
    "start": "node bin/p2p-listen.js",
    "ctl": "node bin/p2p-ctl.js",
    "test": "node test/selftest.js && node test/transfer-selftest.js && node test/webui-selftest.js",
    "test:unit": "node test/selftest.js",
    "test:transfer": "node test/transfer-selftest.js",
    "test:webui": "node test/webui-selftest.js",
    "test:e2e:browser": "bash test/e2e-browser.sh",
    "test:e2e:ai": "bash test/e2e-ai-pair.sh",
    "test:e2e:file": "bash test/e2e-file.sh",
    "test:e2e:fixed-room": "bash test/e2e-fixed-room.sh",
    "selftest": "node test/selftest.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "werift": "^0.24.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
